# ── Workspace root ───────────────────────────────────────────────────
# Agent tooling, not part of any project
.agents/
.claude/
skills-lock.json
agent/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Build output
build/
dist/
*.spec
# ...except the hand-written PyInstaller spec, which is build config rather than output
!packaging/notch.spec

# IDE and OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large binaries: speech/face models and installers are rebuilt, not tracked
model/
bench-models/sherpa-onnx-*/
bench-models/*.onnx
bench-models/*.bin

# rea-work: built Electron bundle and NSIS leftovers, not source
rea-work/app/
rea-work/installer/
rea-work/app-js/node_modules/
rea-work/app-js/dist/

# Soak reports are archived under docs/release/, not left at the repo root
soak-result.json

# Recorded sessions and logs (start-notch.bat writes notch-run.log)
.sessions/
*.log
notch-run*.err
head-runtime.log

# One-shot patch scripts and scratch captures
packaging/patch_*.py
